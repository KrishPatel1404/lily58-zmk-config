#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                              &kp N6       &kp N7     &kp N8     &kp N9    &kp N0     &kp EQUAL
&kp TAB     &kp Q   &kp W   &kp E     &kp R     &kp T                               &kp Y        &kp U      &kp I      &kp O     &kp P      &kp MINUS
&kp ESCAPE  &kp A   &kp S   &kp D     &kp F     &kp G                               &kp H        &kp J      &kp K      &kp L     &kp SEMI   &kp BACKSPACE
&kp LCTRL   &kp Z   &kp X   &kp C     &kp V     &kp B   &kp SCROLLLOCK  &kp APOSTROPHE  &kp N    &kp M      &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT
                            &kp LALT  &kp LGUI  &mo 1   &kp SPACE       &kp RET         &mo 2    &kp LEFT   &kp RIGHT
            >;

            // Left encoder: CW = page down, CCW = page up
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none     &none       &bt BT_CLR                                     &kp F7     &kp F8     &kp F9           &kp F10    &kp F11   &kp F12
&kp F1        &kp F2        &kp F3        &kp F4    &kp F5      &kp F6                                         &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR   &kp RPAR  &kp TILDE
&kp GRAVE     &kp EXCL      &kp AT        &kp HASH  &kp DOLLAR  &kp PRCNT                                      &kp LEFT   &kp DOWN   &kp UP           &kp RIGHT  &trans    &trans
&trans        &trans        &trans        &trans    &trans      &trans      &kp C_BRIGHTNESS_AUTO   &trans     &trans     &kp MINUS  &kp KP_PLUS      &kp LBRC   &kp RBRC  &kp PIPE
                                          &trans    &trans      &trans      &trans                  &trans     &trans     &trans     &trans
            >;

            // Left encoder: CW = brightness up, CCW = brightness down
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp K_MUTE    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans
            >;

            // Left encoder: CW = volume up, CCW = volume down
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Empty slots so ZMK Studio can add layers at runtime without a reflash.
        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
