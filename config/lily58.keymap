#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/*
 * Lily58 — 3 layers (Base / Lower / Raise), rotary encoder on the LEFT half.
 *
 * Layer access:  hold LOWER (left thumb, `&mo 1`)  ·  hold RAISE (right thumb, `&mo 2`)
 *
 * The "ENC" cell is the left inner-bottom dead slot (no switch fitted). It holds a
 * marker keycode per layer purely so keymap-drawer draws the encoder knob — see
 * CLAUDE.md. The real encoder action is the `sensor-bindings` line on each layer.
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * ## Base
         *
         * |  L1   |  L2  | L3  |  L4  |  L5  |  L6  |  ENC  |  R0  |  R1  |  R2  |  R3  | R4  |  R5  |  R6   |
         * |-------|------|-----|------|------|------|-------|------|------|------|------|-----|------|-------|
         * | `     |  1   |  2  |  3   |  4   |  5   |       |      |  6   |  7   |  8   |  9  |  0   |  -    |
         * | TAB   |  Q   |  W  |  E   |  R   |  T   |       |      |  Y   |  U   |  I   |  O  |  P   |  =    |
         * | ESC   |  A   |  S  |  D   |  F   |  G   |       |      |  H   |  J   |  K   |  L  |  ;   | BSPC  |
         * | LCTRL |  Z   |  X  |  C   |  V   |  B   |  scrl |  '   |  N   |  M   |  ,   |  .  |  /   | RSHFT |
         *
         * |  LT1  |  LT2  |  LT3  |  LT4  |  RT1  |  RT2  |  RT3  |  RT4  |
         * |-------|-------|-------|-------|-------|-------|-------|-------|
         * | ⌥ / ↑ | ⌘ / ↓ | LOWER | SPACE | ENTER | RAISE |  ←    |  →    |
         *
         * ⌥ / ↑ and ⌘ / ↓ are mod-taps: tap = arrow, hold = modifier.
         * Encoder: PAGE UP / PAGE DOWN.
         */

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE   &kp N1  &kp N2  &kp N3       &kp N4         &kp N5                              &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB     &kp Q   &kp W   &kp E        &kp R          &kp T                               &kp Y   &kp U     &kp I      &kp O    &kp P     &kp EQUAL
&kp ESCAPE  &kp A   &kp S   &kp D        &kp F          &kp G                               &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp BACKSPACE
&kp LCTRL   &kp Z   &kp X   &kp C        &kp V          &kp B   &kp SCROLLLOCK    &kp APOS  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                            &mt LALT UP  &mt LGUI DOWN  &mo 1   &kp SPACE         &kp RET   &mo 2   &kp LEFT  &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        /*
         * ## Lower — vim arrows only, everything else transparent
         *
         * |  L1   |  L2  | L3  |  L4  |  L5  |  L6  |  ENC  |  R0  |  R1  |  R2  |  R3  | R4  |  R5  |  R6   |
         * |-------|------|-----|------|------|------|-------|------|------|------|------|-----|------|-------|
         * |       |      |     |      |      |      |       |      |      |      |      |     |      |       |
         * |       |      |     |      |      |      |       |      |      |      |      |     |      |       |
         * |       |      |     |      |      |      |       |      |  ←   |  ↓   |  ↑   |  →  |      |       |
         * |       |      |     |      |      |      | brght |      |      |      |      |     |      |       |
         *
         * Arrows sit on H / J / K / L. Encoder: brightness up / down.
         */

        lower_layer {
            display-name = "Lower";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                   &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_AUTO    &trans  &trans    &trans    &trans  &trans     &trans  &trans
                        &trans  &trans  &trans  &trans                   &trans  &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        /*
         * ## Raise — Bluetooth profiles, media, symbols
         *
         * |  L1   |  L2  | L3  |  L4  |  L5  |  L6  |  ENC  |  R0  |  R1  |  R2  |  R3  | R4  |  R5  |  R6   |
         * |-------|------|-----|------|------|------|-------|------|------|------|------|-----|------|-------|
         * |       | BT 0 | BT 1| BT 2 |      | BTCLR|       |      |      |      |      |     |      |       |
         * |       |      |     |      |      |      |       |      |      |      |      |     |      |       |
         * |       |      |     |      |      |      |       |      |  ^   |  &   |  *   |  (  |  )   |  ~    |
         * |       |      |     |      |  ⏮   |  ⏭   |  vol  |      |      |  -   |  +   |  {  |  }   |  \|   |
         *
         * |  LT1  |  LT2  |  LT3  |  LT4  |  RT1  |  RT2  |  RT3  |  RT4  |
         * |-------|-------|-------|-------|-------|-------|-------|-------|
         * |       |       |       |  ⏯    |       |       |       |       |
         *
         * BT 0-2 select a host profile; BTCLR clears the bond on the active one.
         * Encoder: volume up / down.
         */

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans      &bt BT_CLR                              &trans     &trans     &trans           &trans    &trans    &trans
&trans  &trans        &trans        &trans        &trans      &trans                                  &trans     &trans     &trans           &trans    &trans    &trans
&trans  &trans        &trans        &trans        &trans      &trans                                  &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp TILDE
&trans  &trans        &trans        &trans        &kp C_PREV  &kp C_NEXT  &kp K_MUTE          &trans  &trans     &kp MINUS  &kp KP_PLUS      &kp LBRC  &kp RBRC  &kp PIPE
                                    &trans        &trans      &trans      &kp C_PLAY_PAUSE    &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
